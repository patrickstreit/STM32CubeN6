{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/../gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Debug + Bench",
            "displayName": "Debug + Bench",
            "inherits": "Debug",
            "binaryDir": "${sourceDir}/build/Debug-Bench",
            "cacheVariables": {
                "PSRAM_BENCH": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Debug + Bench",
            "displayName": "Debug + Bench",
            "configurePreset": "Debug + Bench"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}