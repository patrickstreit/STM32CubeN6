{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/../gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "CsiProbe",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CSI_PROBE_MODE": "ON"
            }
        },
        {
            "name": "DebugAxiInput",
            "inherits": "Debug",
            "cacheVariables": {
                "VENC_M2_AXISRAM_INPUT": "ON"
            }
        },
        {
            "name": "DebugSmallRing",
            "inherits": "Debug",
            "cacheVariables": {
                "VENC_SMALL_BITSTREAM_RING": "ON"
            }
        },
        {
            "name": "DebugBitstreamPsram",
            "inherits": "DebugSmallRing",
            "cacheVariables": {
                "VENC_BITSTREAM_IN_PSRAM": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "CsiProbe",
            "configurePreset": "CsiProbe"
        },
        {
            "name": "DebugAxiInput",
            "configurePreset": "DebugAxiInput"
        },
        {
            "name": "DebugSmallRing",
            "configurePreset": "DebugSmallRing"
        },
        {
            "name": "DebugBitstreamPsram",
            "configurePreset": "DebugBitstreamPsram"
        }
    ]
}
