{
    "version": "0.2.0",
    // The two configurations mirror the two flash tasks, because they mirror the
    // two build workflows:
    //   - an Appli-only preset (Debug, CsiProbe, ...) built straight from
    //     Appli/CMakePresets.json, with the FSBL left as it is
    //   - a top-level preset, where the root CMakeLists builds FSBL and Appli
    //     together into */build/${CMAKE_BUILD_TYPE}
    // Each asks for exactly one preset name; picking a single one for both images
    // would be wrong in the first case, since CsiProbe has no FSBL counterpart.
    "configurations": [
        {
            // FSBL is loaded with full symbols; Appli symbols are added after the
            // FSBL hands over control in BOOT_Application (LRUN boot scheme).
            //
            // The FSBL comes from build/Debug: it is unaffected by the Appli
            // compile definitions that the Appli presets differ in, so there is
            // nothing preset-specific about it here.
            "name": "STM32N6-DK / VENC / Appli preset (FSBL from Debug)",
            "cwd": "${workspaceFolder:VENC_SDCard_ThreadX}",
            "executable": "FSBL/build/Debug/VENC_SDCard_ThreadX_FSBL.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            "showDevDebugOutput": "raw",
            "runToEntryPoint": "BOOT_Application",
            // Set Environment variable STM32_SVD_PATH. Might be one of the following paths:
            // C:\Program Files (x86)\STMicroelectronics\STM32CubeProgrammer\SVD
            // C:\Users\%USERNAME%\AppData\Local\stm32cube\packs\STMicroelectronics\stm32n6xx_dfp\1.2.0\SVD
            "svdPath": "${env:STM32_SVD_PATH}/STM32N657.svd", //
            // "preLaunchTask": "Flash STM32N6 (DEVBOOT)",
            "serverArgs": [
                "-m",
                "1",
                "-el",
                "${env:STM32_PRG_PATH}/ExternalLoader/MX66UW1G45G_STM32N6570-DK.stldr"
            ],
            "overrideLaunchCommands": [
                "-target-download",
                "monitor halt"
            ],
            // GDB interprets backslashes as escapes, so this raw command needs a
            // forward-slash path (${workspaceFolder} would expand to \\). It stays
            // relative to "cwd" above; the input only substitutes a preset name.
            "postLaunchCommands": [
                "add-symbol-file Appli/build/${input:appliPreset}/VENC_SDCard_ThreadX_Appli.elf"
            ]
        },
        {
            // Both images from one top-level preset, so a single name is correct
            // for the FSBL executable and the Appli symbols alike.
            "name": "STM32N6-DK / VENC / FSBL + Appli (top-level preset)",
            "cwd": "${workspaceFolder:VENC_SDCard_ThreadX}",
            "executable": "FSBL/build/${input:topLevelPreset}/VENC_SDCard_ThreadX_FSBL.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            "showDevDebugOutput": "raw",
            "runToEntryPoint": "BOOT_Application",
            "svdPath": "${env:STM32_SVD_PATH}/STM32N657.svd",
            "serverArgs": [
                "-m",
                "1",
                "-el",
                "${env:STM32_PRG_PATH}/ExternalLoader/MX66UW1G45G_STM32N6570-DK.stldr"
            ],
            "overrideLaunchCommands": [
                "-target-download",
                "monitor halt"
            ],
            "postLaunchCommands": [
                "add-symbol-file Appli/build/${input:topLevelPreset}/VENC_SDCard_ThreadX_Appli.elf"
            ]
        }
    ],
    "inputs": [
        {
            // Preset names from Appli/CMakePresets.json, whose binaryDir is
            // build/${presetName}. DebugWithOptions is listed as well because the
            // top-level build produces that directory too.
            "id": "appliPreset",
            "type": "pickString",
            "description": "Appli preset whose symbols to load",
            "options": [
                "Debug",
                "CsiProbe",
                "DebugWithOptions",
                "Release"
            ],
            "default": "Debug"
        },
        {
            // Preset names from ./CMakePresets.json. They end up as
            // CMAKE_BUILD_TYPE and therefore as the sub-build directory names.
            "id": "topLevelPreset",
            "type": "pickString",
            "description": "Top-level preset to debug",
            "options": [
                "Debug",
                "DebugWithOptions",
                "Release"
            ],
            "default": "Debug"
        }
    ]
}
